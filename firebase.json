{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "target": "production",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "redirects": [
        {
          "source": "/index.html",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/home",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/inicio",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/propiedades",
          "destination": "/catalogo",
          "type": 301
        },
        {
          "source": "/properties",
          "destination": "/catalogo",
          "type": 301
        },
        {
          "source": "/listings",
          "destination": "/catalogo",
          "type": 301
        },
        {
          "source": "/catalog",
          "destination": "/catalogo",
          "type": 301
        },
        {
          "source": "/contact",
          "destination": "/contacto",
          "type": 301
        },
        {
          "source": "/privacy",
          "destination": "/politica-privacidad",
          "type": 301
        },
        {
          "source": "/privacy-policy",
          "destination": "/politica-privacidad",
          "type": 301
        },
        {
          "source": "/nosotros",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/about",
          "destination": "/",
          "type": 301
        }
      ],
      "rewrites": [
        { "source": "/sitemap.xml",           "function": "generateSitemap" },
        { "source": "/sitemap-index.xml",     "function": "generateSitemap" },
        { "source": "/sitemap-properties.xml","function": "generateSitemap" },
        { "source": "/sitemap-cities.xml",    "function": "generateSitemap" },
        { "source": "/sitemap-static.xml",    "function": "generateSitemap" },

        { "source": "/",                      "function": "serveApp" },
        { "source": "/catalogo{,/**}",        "function": "serveApp" },
        { "source": "/propiedades/**",        "function": "serveApp" },
        { "source": "/contacto",              "function": "serveApp" },

        { "source": "**",                     "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400, must-revalidate"
            },
            {
              "key": "X-Robots-Tag",
              "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
            }
          ]
        },
        {
          "source": "/catalogo{,/**}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=1800, stale-while-revalidate=86400"
            },
            {
              "key": "X-Robots-Tag",
              "value": "index, follow, max-image-preview:large, max-snippet:-1"
            }
          ]
        },
        {
          "source": "/propiedades/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
            },
            {
              "key": "X-Robots-Tag",
              "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
            }
          ]
        },
        {
          "source": "/contacto",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
            },
            {
              "key": "X-Robots-Tag",
              "value": "index, follow"
            }
          ]
        },
        {
          "source": "/politica-privacidad",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
            },
            {
              "key": "X-Robots-Tag",
              "value": "index, follow"
            }
          ]
        },
        {
          "source": "/agendar-visita{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, follow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/acceso-clientes{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/login{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/solicitar-acceso{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/dashboard{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/mi-panel{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/portal{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/propiedades-admin{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/clientes{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/contratos{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/consultas{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/documentos{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/calendario{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/visitas{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/usuarios{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/solicitudes{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/perfil{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "/agentes{,/**}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Cache-Control",
              "value": "private, no-store, max-age=0"
            }
          ]
        },
        {
          "source": "**/*.@(js|mjs|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(woff|woff2|ttf|otf|eot)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|png|gif|webp|avif|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(mp4|webm|ogg|mp3|wav)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, stale-while-revalidate=2592000"
            }
          ]
        },
        {
          "source": "/sitemap*.xml",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/xml; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=900, s-maxage=1800, stale-while-revalidate=3600"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex"
            }
          ]
        },
        {
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, s-maxage=86400"
            }
          ]
        },
        {
          "source": "/site.webmanifest",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, s-maxage=604800"
            }
          ]
        },
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            { "key": "Cache-Control",          "value": "no-cache, no-store, must-revalidate" },
            { "key": "Pragma",                 "value": "no-cache" },
            { "key": "Service-Worker-Allowed", "value": "/" },
            { "key": "Content-Type",           "value": "application/javascript; charset=utf-8" }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), fullscreen=(self), display-capture=(), accelerometer=(), gyroscope=(), magnetometer=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "Cross-Origin-Resource-Policy",
              "value": "same-site"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://www.google.com https://www.recaptcha.net https://apis.google.com https://maps.googleapis.com https://*.firebaseapp.com; script-src-elem 'self' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://www.google.com https://www.recaptcha.net https://apis.google.com https://maps.googleapis.com https://*.firebaseapp.com https://*.firebaseio.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' data: https://fonts.gstatic.com https://api.fontshare.com; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://lh3.googleusercontent.com https://www.google.com https://www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com https://*.googleusercontent.com; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://fcm.googleapis.com https://firebaseinstallations.googleapis.com https://firebaseappcheck.googleapis.com https://content-firebaseappcheck.googleapis.com https://firebasestorage.googleapis.com https://www.google-analytics.com https://www.google.com https://www.recaptcha.net https://maps.googleapis.com https://*.cloudfunctions.net https://us-central1-inmobiliaria-ryb-y-asociados.cloudfunctions.net wss://*.firebaseio.com; frame-src 'self' https://www.google.com https://www.recaptcha.net https://accounts.google.com https://inmobiliaria-ryb-y-asociados.firebaseapp.com; media-src 'self' blob: https://firebasestorage.googleapis.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
            }
          ]
        }
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}