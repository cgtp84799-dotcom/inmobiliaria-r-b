# ═══════════════════════════════════════════════════════════════════════════
#  Variables de entorno — Inmobiliaria Rincón Bedoya y Asociados
#
#  COPIAR a .env.local en la raíz del proyecto y rellenar con los valores
#  reales de tu proyecto Firebase. NUNCA commitear .env.local.
#
#  Todas las variables deben empezar con VITE_ para que Vite las exponga
#  al bundle del cliente. Recordar que Firebase API keys web NO son secretas;
#  la seguridad real vive en Firestore Rules + App Check + HTTP Referrers.
# ═══════════════════════════════════════════════════════════════════════════

# ── Firebase core (obtener en Firebase Console → Project Settings) ────────────
VITE_FIREBASE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── App Check (reCAPTCHA v3 site key) ─────────────────────────────────────────
# Firebase Console → App Check → Web apps → Register → reCAPTCHA v3
VITE_FIREBASE_APP_CHECK_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase Cloud Messaging (VAPID) ──────────────────────────────────────────
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_VAPID_KEY=BKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Maps (opcional, para PropertyMap y LocationPicker) ─────────────────
# Google Cloud Console → APIs & Services → Credentials → Restringir por HTTP referrer
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WhatsApp Business (opcional) ──────────────────────────────────────────────
# Número sin "+" ni espacios, formato internacional. Ej: 573105968202
VITE_WA_NUMBER=573105968202

# ── Cloud Functions base URL (opcional, sobrescribe el default de us-central1) ─
# Útil cuando las functions están en región diferente o en Cloud Run (gen2).
# VITE_FUNCTIONS_BASE_URL=https://us-central1-tu-proyecto.cloudfunctions.net
