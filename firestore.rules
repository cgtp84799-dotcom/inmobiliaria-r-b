// FIX [SEGURIDAD]: cierre de exposición por rol viewer en contratos/visitas/documentos/mail y catálogo público limitado a status='published'.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════════════
    // HELPERS DE AUTENTICACIÓN
    // ════════════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(authEmail());
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function getUserData() {
      return userExists() ? get(userDocPath()).data : null;
    }

    function hasRole(roles) {
      return userExists()
          && getUserData() != null
          && getUserData().role is string
          && getUserData().role in roles;
    }

    function isOwner(userId) {
      return isSignedIn() && authEmail() == userId;
    }

    // ════════════════════════════════════════════════════════════════════════
    // ROLES INTERNOS
    // ════════════════════════════════════════════════════════════════════════

    function isAdmin()    { return hasRole(['admin']); }
    function canOperate() { return hasRole(['admin', 'member']); }
    function canRead()    { return hasRole(['admin', 'member', 'viewer']); }

    // ════════════════════════════════════════════════════════════════════════
    // HELPERS PORTAL CLIENTES
    // ════════════════════════════════════════════════════════════════════════

    function isClientOwnerByResource() {
      return isSignedIn() && resource.data.email == authEmail();
    }

    function isClientOwnerByRequest() {
      return isSignedIn() && request.resource.data.email == authEmail();
    }

    function isNotifOwner() {
      return isSignedIn() && resource.data.userId == authEmail();
    }

    function isVisitOwner() {
      return isSignedIn() && resource.data.clientEmail == authEmail();
    }

    function isContractOwner() {
      return isSignedIn() && resource.data.clientEmail == authEmail();
    }

    function isDocumentOwner() {
      return isSignedIn() && resource.data.clientEmail == authEmail();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CAMPOS PERMITIDOS EN UPDATE (whitelist)
    // ════════════════════════════════════════════════════════════════════════

    function clientAllowedUpdateFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nombre', 'telefono', 'ubicacionInteres', 'presupuesto',
        'tipoPropiedad', 'favorites', 'updatedAt', 'onboardingDone', 'photoURL'
      ]);
    }

    function userSelfAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'phone', 'photoURL', 'updatedAt', 'lastSeen',
        'online', 'fcmToken', 'lastTokenUpdate', 'notificationsEnabled',
        // ★ FIX (auditoría): staff (admin/member) guarda favoritos en su
        // propio doc /users/{email} en vez de /clients (evita aparecer como
        // cliente fantasma en el panel).
        'favorites',
      ]);
    }

    function notifAllowedUpdateFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'read', 'readAt'
      ]);
    }

    function clientVisitAllowedUpdateFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'updatedAt', 'cancelledByClient', 'cancelReason'
      ]);
    }

    // ════════════════════════════════════════════════════════════════════════
    // VALIDADORES ANTI-SPAM (colecciones públicas)
    // ════════════════════════════════════════════════════════════════════════

    function validContact() {
      let d = request.resource.data;
      // Whitelist: campos que el código real escribe desde ContactPage,
      // PropertyContactForm y onContactCreated trigger. updatedAt es mirror
      // de createdAt. interest y source son metadata útil para clasificación.
      let allowedKeys = [
        'name', 'email', 'phone', 'message',
        'propertyId', 'propertyTitle',
        'createdAt', 'updatedAt', 'status',
        'interest', 'source',
      ];
      return d.keys().hasOnly(allowedKeys)
          && d.name is string && d.name.size() > 0 && d.name.size() < 200
          && d.email is string && d.email.matches('.*@.*\\..*')
          && d.message is string && d.message.size() > 0 && d.message.size() < 3000
          && d.status == 'pending'
          && d.createdAt == request.time;
    }

    function validVisit() {
      let d = request.resource.data;
      // Whitelist: campos públicos obligatorios + opcionales que el código
      // real escribe (sourceCollection desde visit.service.js, agentId desde
      // staff que crea visita en nombre del cliente, clientId si el portal
      // ya resolvió el cliente, updatedAt como mirror de createdAt,
      // privacyAccepted/privacyAcceptedAt como evidencia Ley 1581/2012,
      // adminNotes vacío como placeholder del flujo).
      // STAFF (canOperate) crea visitas con muchos campos extra; esta función
      // se usa solo en el `allow create` que no requiere canOperate, así que
      // se aplica al flujo público. Para staff, ya hay canOperate en update.
      let allowedKeys = [
        'clientName', 'clientEmail', 'clientPhone',
        'clientId',
        'propertyId', 'propertyName', 'propertyAddress',
        'requestedDate', 'requestedTime', 'notes', 'adminNotes',
        'status', 'createdAt', 'updatedAt', 'source', 'sourceCollection',
        'agentId', 'agentName', 'agentEmail',
        'privacyAccepted', 'privacyAcceptedAt',
      ];
      return d.keys().hasOnly(allowedKeys)
          && d.clientName is string && d.clientName.size() > 0 && d.clientName.size() < 200
          && d.clientEmail is string && d.clientEmail.matches('.*@.*\\..*')
          && d.status == 'pending'
          && d.createdAt == request.time;
    }

    function validAccessRequest() {
      let d = request.resource.data;
      // Whitelist: campos creados por request.service.js .createRequest.
      // approvedBy/approvedAt/assignedRole se inicializan como null y son
      // mutados solo por admin (allow update if isAdmin).
      let allowedKeys = [
        'name', 'email', 'phone', 'message',
        'role', 'createdAt', 'status',
        'approvedBy', 'approvedAt', 'assignedRole',
      ];
      return d.keys().hasOnly(allowedKeys)
          && d.email is string && d.email.matches('.*@.*\\..*')
          && d.name is string && d.name.size() > 0 && d.name.size() < 200
          && d.status == 'pending';
    }

    function validConsent() {
      let d = request.resource.data;
      return d.keys().hasOnly([
                'userId', 'accepted', 'timestamp', 'version', 'userAgent'
             ])
          && d.accepted == true
          && d.timestamp == request.time;
    }

    // ════════════════════════════════════════════════════════════════════════
    // USUARIOS
    // ════════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Cada usuario puede leerse a sí mismo; staff puede leer todos
      allow read:   if isAdmin() || isOwner(userId);
      // Solo el propio usuario puede crear su doc (al registrarse)
      allow create: if isSignedIn() && userId == authEmail();
      // Admin puede editar todo; usuario solo sus campos permitidos
      allow update: if isAdmin() || (isOwner(userId) && userSelfAllowedFields());
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // SOLICITUDES DE ACCESO
    // ════════════════════════════════════════════════════════════════════════

    match /accessRequests/{requestId} {
      allow create:         if validAccessRequest();
      allow read:           if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // PRESENCIA (RTDB-style en Firestore)
    // FIX: usar authEmail() como ID, no request.auth.uid
    // ════════════════════════════════════════════════════════════════════════

    match /presence/{userId} {
      allow read:  if canOperate();
      allow write: if canOperate() && authEmail() == userId;
    }

    // ════════════════════════════════════════════════════════════════════════
    // PROPIEDADES
    // ════════════════════════════════════════════════════════════════════════

    match /properties/{propertyId} {
      // Catálogo público — solo propiedades publicadas
      allow read:           if resource.data.status == 'published';
      allow create, update: if canOperate();
      allow delete:         if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CLIENTES
    // ════════════════════════════════════════════════════════════════════════

    match /clients/{clientId} {
      allow read:   if canRead() || isClientOwnerByResource();
      allow create: if canOperate() || isClientOwnerByRequest();
      allow update: if canOperate()
                    || (isClientOwnerByResource() && clientAllowedUpdateFields());
      // ★ FIX (auditoría — duplicados): permitir al cliente borrar duplicados
      // de SU propio email. Esto soporta el flow de auto-fusión en
      // resolveClientByEmail. El admin sigue pudiendo borrar cualquiera.
      allow delete: if isAdmin() || isClientOwnerByResource();

      match /history/{historyId} {
        allow read:   if canRead() || isClientOwnerByResource();
        allow create: if canOperate() || isClientOwnerByResource();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // CONTRATOS
    // ════════════════════════════════════════════════════════════════════════

    match /contracts/{contractId} {
      function isContractOwnerByParent() {
        return isSignedIn()
            && exists(/databases/$(database)/documents/contracts/$(contractId))
            && get(/databases/$(database)/documents/contracts/$(contractId)).data.clientEmail == authEmail();
      }

      allow read:           if canOperate() || isContractOwner();
      allow create, update: if canOperate();
      allow delete:         if isAdmin();

      match /milestones/{milestoneId} {
        allow read:           if canOperate() || isContractOwnerByParent();
        allow create, update: if canOperate();
        allow delete:         if isAdmin();
      }

      match /payments/{paymentId} {
        allow read:           if canOperate() || isContractOwnerByParent();
        allow create, update: if canOperate();
        allow delete:         if isAdmin();
      }

      match /documents/{documentId} {
        allow read:           if canOperate() || isContractOwnerByParent();
        allow create, update: if canOperate();
        allow delete:         if canOperate();
      }

      match /history/{historyId} {
        allow read:           if canOperate() || isContractOwnerByParent();
        allow create:         if canOperate();
        allow update, delete: if isAdmin();
      }

      match /alerts_sent/{alertId} {
        allow read:  if canOperate();
        allow write: if false; // Solo Admin SDK vía Cloud Functions
      }
    }

    // ════════════════════════════════════════════════════════════════════════
    // DOCUMENTOS
    // ════════════════════════════════════════════════════════════════════════

    match /documents/{documentId} {
      allow read:           if canOperate();
      allow create, update: if canOperate();
      allow delete:         if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CONTACTOS
    // FIX: canRead() → canOperate() para que viewer no vea msgs de otros
    // ════════════════════════════════════════════════════════════════════════

    match /contacts/{contactId} {
      allow create:         if validContact();
      allow read:           if canOperate();
      allow update, delete: if canOperate();
    }

    // ════════════════════════════════════════════════════════════════════════
    // VISITAS
    // ════════════════════════════════════════════════════════════════════════

    match /visits/{visitId} {
      allow create: if validVisit();

      allow read: if canOperate() || isVisitOwner();

      allow update: if canOperate()
                    || (
                      isVisitOwner()
                      && clientVisitAllowedUpdateFields()
                      && request.resource.data.status == 'cancelada'
                      && (resource.data.status == 'pending'
                          || resource.data.status == 'approved')
                    );

      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // NOTIFICACIONES
    // ════════════════════════════════════════════════════════════════════════

    match /notifications/{notificationId} {
      allow read: if canOperate() || isNotifOwner();

      allow create: if canOperate()
                    || (isSignedIn() && request.resource.data.userId == authEmail());

      allow update: if (isSignedIn() && isNotifOwner() && notifAllowedUpdateFields())
                    || isAdmin();

      allow delete: if isAdmin() || isNotifOwner();
    }

    // ════════════════════════════════════════════════════════════════════════
    // EMAILS AUTOMÁTICOS (extensión Trigger Email de Firebase)
    //
    //   AUDITORÍA: las reglas anteriores exigían un formato `template+userId+type`
    //   que NO coincide con el que el frontend usa realmente
    //   (`to + message:{subject,html} + createdAt`). Esto rompía:
    //     • visit.service.js (approved/rejected/rescheduled emails al cliente)
    //     • notificationService.js sendMailDoc (notifs con email)
    //     • ClientDetail.jsx handleSendInvite
    //
    //   Hardening real:
    //     • Staff (admin/member) puede encolar cualquier email.
    //     • Cliente firmado puede encolar SOLO emails dirigidos a sí mismo
    //       (to == authEmail()) — no puede usar la infraestructura para spam
    //       a terceros.
    //     • Nadie puede setear `from`, `replyTo`, ni headers raros.
    //     • Nadie puede leer/modificar mails (admin only).
    // ════════════════════════════════════════════════════════════════════════

    function isSafeClientMail() {
      let d = request.resource.data;
      // Cliente solo encola emails a sí mismo, con la forma que usa el código:
      //   { to, message: { subject, html }, createdAt }
      // Permitimos también `userId` y `type` para trazabilidad opcional.
      let allowedKeys = ['to', 'message', 'createdAt', 'userId', 'type'];
      let recipientOk =
          (d.to is string && d.to == authEmail())
          || (d.to is list && d.to.size() == 1 && d.to[0] == authEmail());
      return isSignedIn()
          && d.keys().hasOnly(allowedKeys)
          && recipientOk
          && d.message is map
          && d.message.subject is string && d.message.subject.size() < 300
          && d.message.html    is string && d.message.html.size()    < 200000
          // Bloquear sobreescritura de from/replyTo/headers
          && !d.keys().hasAny(['from', 'replyTo', 'headers', 'cc', 'bcc']);
    }

    match /mail/{mailId} {
      allow create: if canOperate() || isSafeClientMail();
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════════════
    // CONSENTIMIENTO DE PRIVACIDAD
    // ════════════════════════════════════════════════════════════════════════

    match /privacyConsents/{consentId} {
      allow create: if validConsent();
      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // SOLICITUDES DE ELIMINACIÓN DE CUENTA
    //
    // AUDITORÍA: profile.service.js .requestAccountDeletion crea un doc aquí
    // y el trigger onAccountDeletionRequested notifica a admins. Antes esta
    // colección no tenía reglas → quedaba bloqueada en producción.
    // ════════════════════════════════════════════════════════════════════════

    function validAccountDeletionRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'reason', 'status', 'createdAt'])
          && d.email is string && d.email == authEmail()
          && d.uid is string
          && d.status == 'pending'
          && (d.reason == null || (d.reason is string && d.reason.size() < 2000));
    }

    match /accountDeletionRequests/{requestId} {
      // Solo el propio usuario puede solicitar eliminación de su cuenta
      allow create: if isSignedIn() && validAccountDeletionRequest();
      allow read:   if isAdmin();
      // Solo admin procesa la solicitud (status, processedBy, etc.)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CHAT
    //   Hardening:
    //     - Conversations: solo participantes (campo participants: [emails])
    //       pueden leer y escribir. Admins tienen acceso total.
    //     - GroupChat / chatRooms: whitelist de campos + solo participantes.
    //     - chatMessages: validación de longitud y campos.
    // ════════════════════════════════════════════════════════════════════════

    function isConversationParticipant() {
      return isSignedIn()
          && resource != null
          && resource.data.participants is list
          && authEmail() in resource.data.participants;
    }

    function isCreatingAsParticipant() {
      return isSignedIn()
          && request.resource.data.participants is list
          && authEmail() in request.resource.data.participants;
    }

    function validChatMessage() {
      let d = request.resource.data;
      return d.text is string
          && d.text.size() > 0
          && d.text.size() < 5000
          && d.senderEmail == authEmail()
          && d.createdAt == request.time;
    }

    match /conversations/{conversationId} {
      // Chat aislado: ningún usuario, ni siquiera admin, puede leer/escribir
      // conversaciones donde no esté incluido en participants[].
      allow read:   if isConversationParticipant();
      allow create: if canOperate() && isCreatingAsParticipant();
      // Al actualizar no se puede cambiar la lista de participantes si no eres admin participante.
      allow update: if isConversationParticipant()
                    && (isAdmin()
                        || request.resource.data.participants == resource.data.participants);
      allow delete: if isConversationParticipant() && isAdmin();

      match /messages/{messageId} {
        // Se lee/escribe solo si eres participante de la conversación padre
        function isParentParticipant() {
          return isSignedIn()
              && exists(/databases/$(database)/documents/conversations/$(conversationId))
              && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants is list
              && authEmail() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read:   if isParentParticipant();
        allow create: if isParentParticipant() && validChatMessage();
        allow update: if isParentParticipant()
                      && (authEmail() == resource.data.senderEmail || isAdmin());
        allow delete: if isParentParticipant()
                      && (authEmail() == resource.data.senderEmail || isAdmin());
      }
    }

    match /groupChat/{document=**} {
      // Solo staff con rol operativo; admin requerido para borrar
      allow read:  if canOperate();
      allow write: if canOperate();
    }

    match /chatMessages/{messageId} {
      allow read:   if canOperate();
      allow create: if canOperate() && validChatMessage();
      allow update: if canOperate() && authEmail() == resource.data.senderEmail;
      allow delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read:  if canOperate();
      // create/update solo si el usuario está en participants
      allow create: if canOperate()
                    && request.resource.data.participants is list
                    && authEmail() in request.resource.data.participants;
      allow update: if canOperate()
                    && (resource == null
                        || (resource.data.participants is list
                            && authEmail() in resource.data.participants));
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CALENDARIO / CITAS
    // ════════════════════════════════════════════════════════════════════════

    match /events/{eventId} {
      allow read:  if canRead();
      allow write: if canOperate();
    }

    match /appointments/{appointmentId} {
      // AUDITORÍA: appointments es un MIRROR de visits con shape distinto
      // (date/time vs requestedDate/requestedTime, visitId, sourceCollection).
      // Reusar validVisit() rechazaba el mirror del flujo público.
      // Solo staff (canOperate) puede crear directamente; el mirror público
      // se crea desde visit.service.js que ya pasó validVisit en /visits.
      // Aceptamos creación con email del cliente solo cuando viene marcado
      // como espejo (sourceCollection == 'visits') y trae visitId.
      allow create: if canOperate()
                    || (
                      isSignedIn()
                      && request.resource.data.sourceCollection == 'visits'
                      && request.resource.data.visitId is string
                      && request.resource.data.clientEmail == authEmail()
                      && request.resource.data.status == 'pending'
                    )
                    || (
                      // Visitas creadas desde el formulario público sin login
                      request.resource.data.sourceCollection == 'visits'
                      && request.resource.data.visitId is string
                      && request.resource.data.status == 'pending'
                      && request.resource.data.clientEmail is string
                      && request.resource.data.clientEmail.matches('.*@.*\\..*')
                    );
      allow read:           if canOperate() || isVisitOwner();
      allow update, delete: if canOperate();
    }

    // ════════════════════════════════════════════════════════════════════════
    // ANALYTICS / STATS
    // ════════════════════════════════════════════════════════════════════════

    match /analytics/{document=**} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }

    match /activity/{document=**} {
      allow read:  if canRead();
      allow write: if canOperate();
    }

    match /stats/{document=**} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }

    match /counters/{document=**} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════════
    // CONFIGURACIÓN
    // ════════════════════════════════════════════════════════════════════════

    match /settings/{document=**} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

  }
}