rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // getUserData() lee por email (el docId en /users es el email del usuario).
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSignedIn() && userExists() && getUserData().role == 'admin';
    }

    function isMemberOrAdmin() {
      return isSignedIn() && userExists() && getUserData().role in ['admin', 'member'];
    }

    // userId en /users es siempre el email (docId = email), no el uid de Auth.
    function isOwner(userId) {
      return isSignedIn() && request.auth.token.email == userId;
    }


    // ── USUARIOS ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if true;  // registro público + Cloud Function createUserByAdmin
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }


    // ── SOLICITUDES DE ACCESO ───────────────────────────────────────────────
    match /accessRequests/{requestId} {
      allow create: if true;  // usuarios sin cuenta pueden solicitar acceso
      allow read:   if isSignedIn();
      allow update, delete: if isAdmin();
    }


    // ── PRESENCIA ───────────────────────────────────────────────────────────
    match /presence/{userId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }


    // ── PROPIEDADES ─────────────────────────────────────────────────────────
    match /properties/{propertyId} {
      allow read:            if true;  // catálogo público
      allow create, update:  if isMemberOrAdmin();
      allow delete:          if isAdmin();
    }


    // ── CLIENTES ────────────────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read:           if isMemberOrAdmin();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();

      // Historial de actividad del cliente (visitas, contratos, etc.)
      // Se crea automáticamente al aprobar/completar una visita.
      match /history/{historyId} {
        allow read:   if isMemberOrAdmin();
        allow create: if isMemberOrAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }


    // ── CONTRATOS ───────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
    }


    // ── DOCUMENTOS ──────────────────────────────────────────────────────────
    match /documents/{documentId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
    }


    // ── CONTACTOS (formulario público de la web) ────────────────────────────
    match /contacts/{contactId} {
      allow create:               if true;
      allow read, update, delete: if isSignedIn();
    }


    // ── VISITAS ─────────────────────────────────────────────────────────────
    // • create: if true  → cualquier visitante puede agendar (formulario público sin login)
    // • read:   autenticados  → admin ve todas; member ve las suyas (filtrado en el hook)
    // • update: member o admin → aprobar, reagendar, completar
    // • delete: solo admin
    match /visits/{visitId} {
      allow create: if true;
      allow read:   if isSignedIn();
      allow update: if isMemberOrAdmin();
      allow delete: if isAdmin();
    }


    // ── CONSENTIMIENTO DE PRIVACIDAD (formulario público) ───────────────────
    // Se guarda cuando el usuario acepta la política al agendar una visita.
    match /privacyConsents/{consentId} {
      allow create: if true;           // formulario público, sin login
      allow read:   if isAdmin();      // solo admin puede consultar consentimientos
      allow delete: if isAdmin();
    }


    // ── EMAILS AUTOMÁTICOS (extensión Trigger Email) ────────────────────────
    // La extensión "Trigger Email from Firestore" lee esta colección y envía
    // los correos. Solo usuarios autenticados (admin/member) pueden crear emails.
    // El servidor (extensión) escribe los campos de estado (delivery, state).
    match /mail/{mailId} {
      allow create: if isSignedIn();   // solo código interno autenticado encola emails
      allow read:   if isAdmin();      // admin puede ver el log de envíos
      allow update: if false;          // solo la extensión Firebase actualiza el estado
      allow delete: if isAdmin();
    }


    // ── CHAT ────────────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
      match /messages/{messageId} {
        allow read:   if isSignedIn();
        allow create: if isMemberOrAdmin();
        allow update: if isSignedIn() && request.auth.token.email == resource.data.senderEmail;
        allow delete: if isAdmin();
      }
    }

    match /groupChat/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isMemberOrAdmin();
    }

    match /chatMessages/{messageId} {
      allow read:           if isSignedIn();
      allow create:         if isMemberOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read:  if isSignedIn();
      allow write: if isMemberOrAdmin();
    }


    // ── NOTIFICACIONES ──────────────────────────────────────────────────────
    // Un usuario solo ve y gestiona sus propias notificaciones.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid ||
                      resource.data.userId == request.auth.token.email);
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.userId == request.auth.token.email);
      allow delete: if isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.userId == request.auth.uid ||
                         resource.data.userId == request.auth.token.email));
    }


    // ── CALENDARIO ──────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }


    // ── ANALYTICS Y STATS ───────────────────────────────────────────────────
    match /analytics/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /activity/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /stats/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }


    // ── CONTADORES ──────────────────────────────────────────────────────────
    match /counters/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }


    // ── CONFIGURACIÓN ───────────────────────────────────────────────────────
    match /settings/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
