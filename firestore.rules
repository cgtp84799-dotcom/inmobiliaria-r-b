rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // getUserData() lee por email (el docId en /users es el email del usuario).
    // Si el doc no existe durante el registro, la regla deniega por defecto — comportamiento correcto.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSignedIn() && userExists() && getUserData().role == 'admin';
    }

    function isMemberOrAdmin() {
      return isSignedIn() && userExists() && getUserData().role in ['admin', 'member'];
    }

    // userId en /users es siempre el email (docId = email), no el uid de Auth.
    function isOwner(userId) {
      return isSignedIn() && request.auth.token.email == userId;
    }


    // ── USUARIOS ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if true;  // registro público + Cloud Function createUserByAdmin
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }


    // ── SOLICITUDES DE ACCESO ───────────────────────────────────────────────
    match /accessRequests/{requestId} {
      allow create: if true;  // usuarios sin cuenta pueden solicitar acceso
      allow read:   if isSignedIn();
      allow update, delete: if isAdmin();
    }


    // ── PRESENCIA ───────────────────────────────────────────────────────────
    match /presence/{userId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }


    // ── PROPIEDADES ─────────────────────────────────────────────────────────
    match /properties/{propertyId} {
      allow read:            if true;  // catálogo público
      allow create, update:  if isMemberOrAdmin();
      allow delete:          if isAdmin();
    }


    // ── CLIENTES ────────────────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
    }


    // ── CONTRATOS ───────────────────────────────────────────────────────────
    match /contracts/{contractId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
    }


    // ── DOCUMENTOS ──────────────────────────────────────────────────────────
    match /documents/{documentId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
    }


    // ── CONTACTOS (formulario público de la web) ─────────────────────────
    match /contacts/{contactId} {
      allow create:            if true;
      allow read, update, delete: if isSignedIn();
    }


    // ── VISITAS ─────────────────────────────────────────────────────────────
    // Cualquier visitante puede solicitar una visita (create: if true).
    // Solo admin/member gestionan el estado; cualquier usuario autenticado puede leer.
    match /visits/{visitId} {
      allow create: if true;   // formulario público de agendar visita
      allow read:   if isSignedIn();
      allow update: if isMemberOrAdmin();
      allow delete: if isAdmin();
    }


    // ── CHAT ────────────────────────────────────────────────────────────────
    // viewers solo leen; member/admin pueden crear y escribir.
    match /conversations/{conversationId} {
      allow read:           if isSignedIn();
      allow create, update: if isMemberOrAdmin();
      allow delete:         if isAdmin();
      match /messages/{messageId} {
        allow read:   if isSignedIn();
        allow create: if isMemberOrAdmin();
        allow update: if isSignedIn() && request.auth.token.email == resource.data.senderEmail;
        allow delete: if isAdmin();
      }
    }

    match /groupChat/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isMemberOrAdmin();
    }

    match /chatMessages/{messageId} {
      allow read:          if isSignedIn();
      allow create:        if isMemberOrAdmin();
      allow update, delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read:  if isSignedIn();
      allow write: if isMemberOrAdmin();
    }


    // ── NOTIFICACIONES ──────────────────────────────────────────────────────
    // Un usuario solo ve y gestiona sus propias notificaciones.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid ||
                      resource.data.userId == request.auth.token.email);
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.userId == request.auth.token.email);
      allow delete: if isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.userId == request.auth.uid ||
                         resource.data.userId == request.auth.token.email));
    }


    // ── CALENDARIO ──────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }


    // ── ANALYTICS Y STATS ── solo admin escribe ────────────────────────────
    match /analytics/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /activity/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /stats/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }


    // ── CONTADORES ── solo admin escribe para evitar manipulación ──────────
    match /counters/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }


    // ── CONFIGURACIÓN ───────────────────────────────────────────────────────
    match /settings/{document=**} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
