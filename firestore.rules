rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS DE AUTENTICACIÓN ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // El docId en /users es siempre el email del usuario
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    // ── ROLES ────────────────────────────────────────────────────────────────
    // admin  → control total del sistema
    // member → agente inmobiliario: acceso operativo completo (sin gestión de usuarios/config)
    // viewer → solo lectura sobre contenido operativo

    function isAdmin() {
      return isSignedIn() && userExists() && getUserData().role == 'admin';
    }

    function isMember() {
      return isSignedIn() && userExists() && getUserData().role == 'member';
    }

    function isViewer() {
      return isSignedIn() && userExists() && getUserData().role == 'viewer';
    }

    // Puede operar (crear, editar): admin + member
    function canOperate() {
      return isSignedIn() && userExists() && getUserData().role in ['admin', 'member'];
    }

    // Puede leer contenido operativo: admin + member + viewer
    function canRead() {
      return isSignedIn() && userExists() && getUserData().role in ['admin', 'member', 'viewer'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.token.email == userId;
    }


    // ── USUARIOS ─────────────────────────────────────────────────────────────
    // Gestión de cuentas: solo admin puede crear/modificar/eliminar otros usuarios.
    // Cada usuario puede actualizar su propio perfil.
    // viewer puede leer la lista para ver agentes asignados, etc.
    match /users/{userId} {
      allow read:   if canRead();
      allow create: if true;                    // registro público + Cloud Function admin
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }


    // ── SOLICITUDES DE ACCESO ────────────────────────────────────────────────
    // Solo admin gestiona quién entra al sistema.
    match /accessRequests/{requestId} {
      allow create: if true;                    // cualquiera puede solicitar acceso
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }


    // ── PRESENCIA ────────────────────────────────────────────────────────────
    match /presence/{userId} {
      allow read:  if canRead();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }


    // ── PROPIEDADES ──────────────────────────────────────────────────────────
    // Catálogo público: cualquiera puede ver propiedades (portal web).
    // Crear/editar: admin y member (agente inmobiliario trabaja propiedades).
    // Eliminar: solo admin.
    match /properties/{propertyId} {
      allow read:           if true;            // catálogo público
      allow create, update: if canOperate();
      allow delete:         if isAdmin();
    }


    // ── CLIENTES ─────────────────────────────────────────────────────────────
    // Agentes inmobiliarios gestionan clientes diariamente.
    // viewer puede consultar el CRM sin modificar.
    match /clients/{clientId} {
      allow read:           if canRead();
      allow create, update: if canOperate();
      allow delete:         if isAdmin();

      match /history/{historyId} {
        allow read:   if canRead();
        allow create: if canOperate();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }


    // ── CONTRATOS ────────────────────────────────────────────────────────────
    // Agentes firman y gestionan contratos.
    match /contracts/{contractId} {
      allow read:           if canRead();
      allow create, update: if canOperate();
      allow delete:         if isAdmin();
    }


    // ── DOCUMENTOS ───────────────────────────────────────────────────────────
    match /documents/{documentId} {
      allow read:           if canRead();
      allow create, update: if canOperate();
      allow delete:         if isAdmin();
    }


    // ── CONTACTOS (formulario público web) ───────────────────────────────────
    match /contacts/{contactId} {
      allow create:         if true;            // formulario público sin login
      allow read:           if canRead();
      allow update, delete: if canOperate();
    }


    // ── VISITAS ───────────────────────────────────────────────────────────────
    // create: público — cualquier visitante agenda desde el portal
    // read: todos los roles autenticados (viewer puede ver el historial)
    // update: agente y admin (aprobar, rechazar, reagendar, completar)
    // delete: solo admin
    match /visits/{visitId} {
      allow create: if true;                    // formulario público sin login
      allow read:   if canRead();
      allow update: if canOperate();
      allow delete: if isAdmin();
    }


    // ── CONSENTIMIENTO DE PRIVACIDAD ─────────────────────────────────────────
    match /privacyConsents/{consentId} {
      allow create: if true;                    // formulario público sin login
      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }


    // ── EMAILS AUTOMÁTICOS (extensión Trigger Email) ─────────────────────────
    match /mail/{mailId} {
      allow create: if canOperate();            // solo código interno autenticado encola emails
      allow read:   if isAdmin();
      allow update: if false;                   // solo la extensión Firebase actualiza estado
      allow delete: if isAdmin();
    }


    // ── CHAT ─────────────────────────────────────────────────────────────────
    // viewer no tiene acceso al chat (comunicación operativa interna)
    match /conversations/{conversationId} {
      allow read:           if canOperate();
      allow create, update: if canOperate();
      allow delete:         if isAdmin();
      match /messages/{messageId} {
        allow read:         if canOperate();
        allow create:       if canOperate();
        allow update:       if canOperate() && request.auth.token.email == resource.data.senderEmail;
        allow delete:       if isAdmin();
      }
    }

    match /groupChat/{document=**} {
      allow read:  if canOperate();
      allow write: if canOperate();
    }

    match /chatMessages/{messageId} {
      allow read:           if canOperate();
      allow create:         if canOperate();
      allow update, delete: if isAdmin();
    }

    match /chatRooms/{roomId} {
      allow read:  if canOperate();
      allow write: if canOperate();
    }


    // ── NOTIFICACIONES ────────────────────────────────────────────────────────
    // Cada usuario solo gestiona sus propias notificaciones.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid ||
                      resource.data.userId == request.auth.token.email);
      allow create: if canOperate();
      allow update: if isSignedIn() &&
                       (resource.data.userId == request.auth.uid ||
                        resource.data.userId == request.auth.token.email);
      allow delete: if isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.userId == request.auth.uid ||
                         resource.data.userId == request.auth.token.email));
    }


    // ── CALENDARIO ────────────────────────────────────────────────────────────
    // Agentes crean y gestionan eventos de su agenda.
    match /events/{eventId} {
      allow read:   if canRead();
      allow write:  if canOperate();
    }

    match /appointments/{appointmentId} {
      allow create:         if true;            // espejo de visits (formulario público)
      allow read:           if canRead();
      allow update, delete: if canOperate();
    }


    // ── ANALYTICS Y STATS ─────────────────────────────────────────────────────
    // Todos los roles autenticados ven las gráficas y métricas del dashboard.
    match /analytics/{document=**} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }

    match /activity/{document=**} {
      allow read:  if canRead();
      allow write: if canOperate();
    }

    match /stats/{document=**} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }


    // ── CONTADORES ────────────────────────────────────────────────────────────
    // Los agentes necesitan leer contadores para el dashboard y KPIs.
    match /counters/{document=**} {
      allow read:  if canRead();
      allow write: if isAdmin();
    }


    // ── CONFIGURACIÓN DEL SISTEMA ─────────────────────────────────────────────
    // Solo admin accede a configuración (viewer/member no tocan esto).
    match /settings/{document=**} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
