{
  "name": "inmobiliaria-ryb-nueva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting:production",
    "deploy:functions": "cd functions && npm run deploy && cd ..",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "test": "vitest run --no-coverage",
    "test:watch": "vitest",
    "test:rules": "vitest run tests/firestore --no-coverage",
    "test:functions": "vitest run tests/functions --no-coverage",
    "test:frontend": "vitest run tests/frontend --no-coverage",
    "test:validators": "vitest run tests/validators --no-coverage",
    "test:fast": "vitest run tests/validators tests/functions tests/frontend --no-coverage",
    "emulator": "firebase emulators:start --only firestore --project demo-ryb-test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.25",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-is": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.10.0",
    "recharts": "^3.5.1",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^14.27.0",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "terser": "^5.46.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  }
}
