            {/* ─── Main column ───────────────────────────── */}
            <div className="lg:col-span-9">
              {/* Toolbar */}
              <div className="catalog-toolbar">
                <div className="flex items-center gap-3 flex-1 min-w-0">
                  <button
                    className="catalog-toolbar__filter-btn lg:hidden"
                    onClick={() => setDrawerOpen(true)}
