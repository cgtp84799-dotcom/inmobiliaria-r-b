.dark .portal-client .bg-gradient-to-br.from-amber-500\/10,
.dark .portal-client .bg-gradient-to-br.from-amber-600\/5 {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, var(--color-surface) 60%) !important;
}

/* ─── Headings dentro del portal → Fraunces ────────────── */
.portal-client h1,
.portal-client h2 {
  font-family: 'Fraunces', Georgia, ui-serif, serif;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--color-text);
}
.portal-client h3 {
  font-family: 'Inter', system-ui, sans-serif;
  font-weight: 600;
  color: var(--color-text);
}

/* ─── Inputs/selects dentro del portal ─────────────────── */
.portal-client input:not([type="checkbox"]):not([type="radio"]),
.portal-client select,
.portal-client textarea {
  background: var(--color-input-bg);
  border-color: var(--color-input-border);
  color: var(--color-input-text);
}
.portal-client input:focus,
.portal-client select:focus,
.portal-client textarea:focus {
