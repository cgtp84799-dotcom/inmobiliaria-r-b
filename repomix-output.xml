        <StatCard idx={1} icon={FaCalendarCheck} label="Visitas (mes)" value={fmtNumber(stats.visitsThisMonth)}
          accent={PALETTE.green} sub={`Promedio ${team.length > 0 ? Math.round(stats.visitsThisMonth / team.length) : 0} por agente`} />
