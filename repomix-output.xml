  --tw-primary-10:        rgba(180,83,9,0.08);
  --tw-primary-15:        rgba(180,83,9,0.13);
  --tw-primary-20:        rgba(180,83,9,0.18);
  --tw-primary-30:        rgba(180,83,9,0.28);
  --tw-primary-40:        rgba(180,83,9,0.38);
  --tw-primary-50:        rgba(180,83,9,0.48);
}

