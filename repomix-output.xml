              initial={{ x: "-100%" }}
              animate={{ x: 0 }}
              exit={{ x: "-100%" }}
              transition={{ type: "spring", damping: 28, stiffness: 260 }}
              className="fixed left-0 top-0 bottom-0 z-[66] w-[88vw] max-w-sm overflow-y-auto lg:hidden"
              style={{ background: "var(--color-surface)" }}
