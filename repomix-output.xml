            </button>
            <button
              type="submit"
              disabled={loading}
              className="flex-1 px-6 py-3 bg-primary hover:bg-yellow-500 text-slate-950 font-bold rounded-xl transition-colors flex items-center justify-center gap-2 disabled:opacity-50"
