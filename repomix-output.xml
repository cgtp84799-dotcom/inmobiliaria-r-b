                  text-xs text-white
                  transition-colors
                "
              >
                <FaSignOutAlt />
                <span className="flex-1 text-left">Cerrar sesión</span>
              </button>
            </div>

            <p className="mt-3 text-[10px] text-slate-500 leading-snug">
              Tip: presiona Esc para cerrar.
