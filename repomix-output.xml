  --cf-navy: #0b1929;
  --cf-navy-2: #152236;
  --cf-navy-3: #20344f;
  --cf-gold: #c9a84c;
  --cf-gold-2: #ead48c;
  --cf-text: #334155;
  --cf-ink: #1f2937;
