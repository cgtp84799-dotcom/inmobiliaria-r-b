                          >
                            <FaChevronRight className="text-white" />
                          </button>
                        </>
                      )}

                      <div className="absolute bottom-3 left-1/2 -translate-x-1/2 bg-black/60 px-3 py-1 rounded-full text-white text-xs sm:text-sm">
                        {currentImageIndex + 1} / {images.length}
