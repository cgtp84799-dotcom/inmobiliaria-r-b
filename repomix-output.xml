.portal-client .border-red-500\/20,
.portal-client .border-red-500\/30,
.portal-client .border-red-500\/40,
.portal-client .border-red-500\/50 {
  border-color: rgba(239, 68, 68, 0.25) !important;
}

/* ─── Gradientes personalizados ─────────────────────────── */
.portal-client .bg-gradient-to-br.from-amber-500\/10,
.portal-client .bg-gradient-to-br.from-amber-600\/5 {
  background: linear-gradient(135deg, rgba(180, 83, 9, 0.08) 0%, var(--color-surface) 60%) !important;
}
.dark .portal-client .bg-gradient-to-br.from-amber-500\/10,
.dark .portal-client .bg-gradient-to-br.from-amber-600\/5 {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12) 0%, var(--color-surface) 60%) !important;
}

/* ─── Headings dentro del portal → Fraunces ────────────── */
.portal-client h1,
.portal-client h2 {
  font-family: 'Fraunces', Georgia, ui-serif, serif;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--color-text);
}
.portal-client h3 {
  font-family: 'Inter', system-ui, sans-serif;
  font-weight: 600;
  color: var(--color-text);
}

/* ─── Inputs/selects dentro del portal ─────────────────── */
.portal-client input:not([type="checkbox"]):not([type="radio"]),
.portal-client select,
.portal-client textarea {
  background: var(--color-input-bg);
  border-color: var(--color-input-border);
  color: var(--color-input-text);
}
.portal-client input:focus,
.portal-client select:focus,
.portal-client textarea:focus {
  border-color: var(--color-input-focus);
  outline: none;
  box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.15);
}
.dark .portal-client input:focus,
.dark .portal-client select:focus,
.dark .portal-client textarea:focus {
  box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.15);
}
.portal-client input::placeholder,
.portal-client textarea::placeholder {
  color: var(--color-text-faint);
}

/* ─── Hover states adaptados ───────────────────────────── */
.portal-client .hover\:bg-slate-800:hover,
.portal-client .hover\:bg-slate-800\/60:hover,
.portal-client .hover\:bg-slate-900:hover {
  background-color: var(--color-row-hover) !important;
}

/* ─── Shadows adaptados ────────────────────────────────── */
.portal-client .shadow-xl,
.portal-client .shadow-2xl { box-shadow: var(--shadow-card); }

/* ─── Scrollbar customs ────────────────────────────────── */
.portal-client .scrollbar-none {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.portal-client .scrollbar-none::-webkit-scrollbar { display: none; }

/* ═══════════════════════════════════════════════════════════
   MEJORAS DE TIPOGRAFÍA Y TAMAÑOS dentro del portal
═══════════════════════════════════════════════════════════ */

/* Saludo "¡Buenos días, Juan!" — hacerlo más editorial */
.portal-client h2.text-2xl,
.portal-client h2.text-3xl {
  font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem) !important;
  line-height: 1.15 !important;
  letter-spacing: -0.025em !important;
}

/* Bordes redondeados más consistentes */
.portal-client .rounded-2xl { border-radius: 1rem !important; }
.portal-client .rounded-xl  { border-radius: 0.75rem !important; }

/* Mejor contraste para items secundarios */
.portal-client .text-\[11px\],
.portal-client .text-\[10px\] {
  font-weight: 500;
}

/* Imágenes con fondo cuando no hay foto */
.portal-client .bg-slate-800 img[src=""],
.portal-client .bg-slate-800:empty {
  background: var(--color-surface-off) !important;
}

/* Opacity disminuida en modo light para no sangrar */
:root:not(.dark) .portal-client .opacity-60 { opacity: 0.75; }
:root:not(.dark) .portal-client .opacity-50 { opacity: 0.65; }
</file>

