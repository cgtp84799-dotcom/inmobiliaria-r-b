 */
function pendingVisitEmail(d) {
  return {
    subject: `✅ Solicitud de visita recibida — ${d.propertyName}`,
    html: htmlWrapper(
      GRADIENTS.dark,
      `
      <span class="emoji-icon">⏳</span>
      <h1 class="title" style="color:#b8952a;text-align:center;">Solicitud recibida</h1>
