  -ms-overflow-style: none;
}
.portal-client .scrollbar-none::-webkit-scrollbar { display: none; }

/* ═══════════════════════════════════════════════════════════
   MEJORAS DE TIPOGRAFÍA Y TAMAÑOS dentro del portal
═══════════════════════════════════════════════════════════ */

/* Saludo "¡Buenos días, Juan!" — hacerlo más editorial */
.portal-client h2.text-2xl,
.portal-client h2.text-3xl {
  font-size: clamp(1.75rem, 3vw + 0.5rem, 2.25rem) !important;
