  center: { x: 0, opacity: 1 },
  exit:   (dir) => ({ x: dir > 0 ? -56 : 56, opacity: 0 }),
};

const STEPS = [
  { id: 1, label: 'Tus datos',    icon: FaUser        },
  { id: 2, label: 'Fecha y hora', icon: FaCalendarAlt },
