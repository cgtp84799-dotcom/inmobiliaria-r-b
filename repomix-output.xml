  --shadow-lg:   0 10px 30px rgba(0,0,0,0.55), 0 24px 60px rgba(0,0,0,0.4);
  --shadow-glow-gold: 0 0 0 3px rgba(251,191,36,0.25), 0 4px 20px rgba(251,191,36,0.18);

  /* ── Toggle ── */
