            </div>
          </Section>

          {/* ══════════════════════════════════════
              BOTONES DE ACCIÓN (sticky)
          ══════════════════════════════════════ */}
          <div className="flex flex-col sm:flex-row gap-3 pt-4 sticky bottom-0 bg-slate-950 pb-2">
            <button
              type="button"
