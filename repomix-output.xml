                          ? `Etapa: ${getStageLabel(h.from)} → ${getStageLabel(h.to)}`
                          : h.action === 'renewed'
                          ? 'Contrato renovado'
                          : h.action === 'created'
                          ? 'Contrato creado'
                          : h.action}
