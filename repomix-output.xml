import {
  FaCalendarCheck, FaHourglassHalf, FaCheckCircle, FaTimesCircle,
  FaHome, FaFileContract, FaMoneyBillWave, FaBolt, FaArrowRight,
  FaBuilding, FaChartLine, FaTrophy,
} from 'react-icons/fa';
