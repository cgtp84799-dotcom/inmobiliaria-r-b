/* ── RED — mantener para alertas/cancelaciones ─────────── */
.portal-client .text-red-400,
.portal-client .text-red-500 { color: #ef4444 !important; }
.portal-client .bg-red-500\/5,
.portal-client .bg-red-500\/10,
.portal-client .bg-red-500\/15,
.portal-client .bg-red-500\/20 {
