    setSaving(true);
    try {
      await addDoc(collection(db, 'clients', client.id, 'history'), {
        type:      form.type,
        notes:     form.notes,
        date:      form.date,
        time:      form.time,
        agentName: currentUser?.displayName || currentUser?.email?.split('@')[0] || '',
        agentId:   currentUser?.uid || '',
