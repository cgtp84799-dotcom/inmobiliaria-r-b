  .dark .detail-visit-card {
    border-color: rgba(251, 191, 36, 0.25);
  }
  .detail-visit-card__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0.25rem 0 0.75rem 0;
