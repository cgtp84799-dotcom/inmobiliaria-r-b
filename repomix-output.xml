  /* ── Accent gold dark ── */
  --color-gold:           #fbbf24;
  --color-gold-hover:     #fcd34d;
  --color-gold-soft:      #f59e0b;

  /* ── Sidebar ── */
  --color-sidebar-bg:         #070b18;
