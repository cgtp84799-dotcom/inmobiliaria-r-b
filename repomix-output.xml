  color: var(--cf-text);
}

.cf-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  padding: 16px 22px 0;
}

.cf-stat {
  min-height: 78px;
  border: 1px solid var(--cf-line);
  border-radius: 12px;
  background: var(--cf-soft);
  padding: 12px 10px;
  text-align: center;
}

.cf-stat b {
  display: block;
  font-size: 15px;
  color: var(--cf-navy);
  margin-bottom: 4px;
}

.cf-stat span {
