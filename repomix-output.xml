  FaWhatsapp, FaSearch, FaArrowRight, FaMapMarkerAlt,
  FaBan, FaCalendarCheck, FaPhone, FaEnvelope,
  FaBed, FaBath, FaRulerCombined, FaChevronDown,
  FaEdit, FaSave, FaTimes, FaTrash,
} from 'react-icons/fa';
import {
