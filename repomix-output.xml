  --color-footer-border:  rgba(255,255,255,0.06);
  --color-footer-text:    #d4d0c8;
  --color-footer-muted:   #6b6762;

  /* ── Navbar pública ── */
  --color-nav-bg:         rgba(255,255,255,0.88);
  --color-nav-border:     rgba(60,45,20,0.08);
  --color-nav-text:       #14110c;
  --color-nav-text-sub:   #5a534a;

  /* ── Topbar admin ── */
  --color-topbar-bg:      rgba(255,253,249,0.93);
