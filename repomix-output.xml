import { useEffect, useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  FaChevronDown,
  FaChevronUp,
  FaHome,
  FaMapMarkerAlt,
  FaCog,
  FaBalanceScale,
  FaFileAlt,
  FaImages,
  FaTrash,
  FaPlus,
  FaSave,
