  /* ── Gradientes dark ── */
  --gradient-gold:        linear-gradient(135deg, #fcd34d 0%, #fbbf24 55%, #d97706 100%);
  --gradient-gold-subtle: linear-gradient(135deg, rgba(251,191,36,0.14) 0%, rgba(245,158,11,0.07) 100%);
  --gradient-surface:     linear-gradient(160deg, #0a1020 0%, #030812 100%);
  --gradient-card-hover:  linear-gradient(160deg, rgba(251,191,36,0.06) 0%, rgba(252,211,77,0.02) 100%);

  /* ── Paleta heredada — modo OSCURO ── */
