    font-weight: 500;
    color: var(--color-text);
    margin-top: 0.1rem;
    letter-spacing: -0.01em;
  }
}

/* ═══════════════════════════════════════════════════════════
   OVERRIDES — limpiar colores "chispero" legacy
   Preserva estética editorial en componentes viejos
═══════════════════════════════════════════════════════════ */

/* Verdes/azules/naranjas saturados → tonos editoriales */
.bg-emerald-500,
.bg-green-500,
.bg-green-600 {
  background-color: var(--color-surface-2) !important;
  color: var(--color-text) !important;
}
.text-emerald-500,
.text-green-500,
.text-green-400 { color: #16a34a !important; }
.dark .text-green-400 { color: #4ade80 !important; }

.bg-orange-600,
.bg-orange-500 {
  background: var(--gradient-gold) !important;
  color: #18130a !important;
}

.bg-blue-600,
.bg-blue-500 {
  background: rgba(10, 16, 32, 0.88) !important;
  color: #faf7f2 !important;
}
.bg-blue-500\/10 {
  background: rgba(10, 16, 32, 0.06) !important;
}
.dark .bg-blue-500\/10 {
  background: rgba(255, 255, 255, 0.04) !important;
}
.text-blue-400 { color: var(--color-text) !important; }

.bg-yellow-500 {
  background: var(--gradient-gold) !important;
  color: #18130a !important;
}
.bg-yellow-500\/10 {
  background: rgba(251, 191, 36, 0.1) !important;
}
.text-yellow-400 { color: var(--color-gold) !important; }

/* Red solo aceptable en favoritos */
.text-red-500 { color: #ef4444 !important; }

/* Gradient chispero a dorado editorial */
.bg-gradient-to-r.from-primary.via-yellow-500.to-primary,
.bg-gradient-to-br.from-green-600.to-green-700,
.bg-gradient-to-br.from-blue-600.to-blue-700,
.bg-gradient-to-br.from-red-600.to-red-700 {
  background: var(--gradient-gold) !important;
  color: #18130a !important;
}

/* Focus visible dorado */
:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 2px;
}

/* btn-ghost consistente */
.btn-ghost:hover { color: var(--color-gold) !important; }/* ═══════════════════════════════════════════════════════════
   PORTAL DEL CLIENTE — rediseño editorial (v4)
   Pegar al final de src/index.css
   · Respeta el tema global (light/dark)
   · Scope .portal-client para no afectar otros componentes
   · Overrides inteligentes de clases slate/amber para que las
     secciones existentes se vean bien sin reescribirlas
═══════════════════════════════════════════════════════════ */

/* ───────────────────────────────────────────────────────────
   CONTENEDOR BASE
─────────────────────────────────────────────────────────── */
.portal-client {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
  color-scheme: light dark;
}

/* Loading state */
.portal-loading {
  display: flex;
  align-items: center;
  justify-content: center;
}
.portal-loading__spinner {
  color: var(--color-gold);
  font-size: 2rem;
  margin: 0 auto 0.75rem;
  display: block;
  animation: spin 1s linear infinite;
}
.portal-loading__text {
  font-size: 0.875rem;
  color: var(--color-text-muted);
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ───────────────────────────────────────────────────────────
   NAVBAR
─────────────────────────────────────────────────────────── */
.portal-client .portal-navbar {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--color-nav-bg);
  backdrop-filter: blur(14px) saturate(1.4);
  -webkit-backdrop-filter: blur(14px) saturate(1.4);
  border-bottom: 1px solid var(--color-nav-border);
}
.portal-navbar__inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 1rem;
  height: 4rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
@media (min-width: 640px) {
  .portal-navbar__inner { padding: 0 1.5rem; }
}

.portal-navbar__brand {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--color-text-muted);
  transition: color 0.2s ease, gap 0.25s ease;
  flex-shrink: 0;
}
.portal-navbar__brand:hover {
  color: var(--color-gold);
  gap: 0.95rem;
}
.portal-navbar__brand-icon {
  font-size: 0.75rem;
}
.portal-navbar__brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1;
  gap: 0.15rem;
}
.portal-navbar__brand-back {
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-text-faint);
}
.portal-navbar__brand-name {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.125rem;
  font-weight: 500;
  letter-spacing: -0.015em;
  color: var(--color-text);
}

.portal-navbar__actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* ─── User button / menu ─── */
.portal-user-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.65rem;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
}
.portal-user-btn:hover {
  background: var(--color-surface-off);
  border-color: var(--color-border);
}
.portal-user-avatar {
  width: 2rem;
  height: 2rem;
  border-radius: 9999px;
  object-fit: cover;
  border: 2px solid rgba(180, 83, 9, 0.3);
}
.dark .portal-user-avatar {
  border-color: rgba(251, 191, 36, 0.3);
}
.portal-user-avatar--initials {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(180, 83, 9, 0.15);
  color: var(--color-gold);
  font-size: 0.75rem;
  font-weight: 700;
}
.dark .portal-user-avatar--initials {
  background: rgba(251, 191, 36, 0.15);
}
.portal-user-name {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-text);
  max-width: 8rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: none;
}
@media (min-width: 640px) { .portal-user-name { display: block; } }
.portal-user-chevron {
  color: var(--color-text-faint);
  font-size: 0.6rem;
  transition: transform 0.2s ease;
}
.portal-user-chevron.is-open { transform: rotate(180deg); }

.portal-user-menu {
  position: absolute;
  right: 0;
  top: calc(100% + 0.5rem);
  z-index: 40;
  width: 12rem;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  padding: 0.25rem;
}
.portal-user-menu__item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.6rem 0.75rem;
  background: transparent;
  border: none;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  color: var(--color-text);
  text-align: left;
  cursor: pointer;
  transition: all 0.15s ease;
}
.portal-user-menu__item:hover {
  background: var(--color-row-hover);
  color: var(--color-gold);
}
.portal-user-menu__item--danger { color: #ef4444; }
.portal-user-menu__item--danger:hover {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.08);
}
.portal-user-menu__icon {
  font-size: 0.75rem;
  color: var(--color-text-faint);
}
.portal-user-menu__item--danger .portal-user-menu__icon { color: inherit; }
.portal-user-menu__divider {
  height: 1px;
  background: var(--color-divider);
  margin: 0.25rem 0.5rem;
}

/* ───────────────────────────────────────────────────────────
   TABS
─────────────────────────────────────────────────────────── */
.portal-client .portal-tabs {
  position: sticky;
  top: 4rem;
  z-index: 20;
  background: var(--color-nav-bg);
  backdrop-filter: blur(14px) saturate(1.4);
  -webkit-backdrop-filter: blur(14px) saturate(1.4);
  border-bottom: 1px solid var(--color-divider);
}
.portal-tabs__inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 1rem;
}
@media (min-width: 640px) { .portal-tabs__inner { padding: 0 1.5rem; } }
.portal-tabs__scroll {
  display: flex;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  gap: 0.15rem;
}
.portal-tabs__scroll::-webkit-scrollbar { display: none; }

.portal-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.95rem 0.75rem;
  background: transparent;
  border: none;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text-muted);
  white-space: nowrap;
  cursor: pointer;
  transition: color 0.2s ease;
}
.portal-tab:hover { color: var(--color-text); }
.portal-tab::after {
  content: "";
  position: absolute;
  left: 0.75rem;
  right: 0.75rem;
  bottom: -1px;
  height: 2px;
  background: var(--color-gold);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.portal-tab.is-active {
  color: var(--color-gold);
}
.portal-tab.is-active::after { transform: scaleX(1); }
.portal-tab__icon { font-size: 0.8rem; }

/* ───────────────────────────────────────────────────────────
   MAIN
─────────────────────────────────────────────────────────── */
.portal-client .portal-main {
  max-width: 72rem;
  margin: 0 auto;
  padding: 2rem 1rem;
}
@media (min-width: 640px) { .portal-client .portal-main { padding: 2rem 1.5rem; } }

