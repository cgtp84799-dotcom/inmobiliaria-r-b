    await assertFails(updateDoc(doc(ownerCtx.firestore(), 'notifications', 'n-1'), {
      userId: 'admin@ryb.com',
    }));
    await assertFails(updateDoc(doc(ownerCtx.firestore(), 'notifications', 'n-1'), {
      title: 'hackeado',
    }));
  });
});

describe('/settings', () => {
