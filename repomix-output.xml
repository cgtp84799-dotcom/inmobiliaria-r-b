      navigate(PRIVATE_ROUTES.DASHBOARD, { replace:true }); return;
    }
    if (role === USER_ROLES.VIEWER) {
      const dest = from && !from.startsWith('/acceso-clientes') ? from : PRIVATE_ROUTES.CLIENT_PORTAL;
