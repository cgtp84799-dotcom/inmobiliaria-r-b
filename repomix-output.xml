/* src/styles/globals.css
   Utilidades visuales complementarias — se importa después de index.css
   NO duplica variables (están en index.css) */

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   SCROLLBAR GLOBAL (Webkit)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
::-webkit-scrollbar        { width: 7px; height: 7px; }
::-webkit-scrollbar-track  { background: transparent; }
::-webkit-scrollbar-thumb  {
  background: var(--color-border);
  border-radius: 9999px;
  transition: background 0.2s ease;
}
::-webkit-scrollbar-thumb:hover { background: rgba(245,158,11,0.40); }
::-webkit-scrollbar-corner { background: transparent; }

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   TIPOGRAFÍA ADICIONAL
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.text-11px   { font-size: 0.6875rem; line-height: 1.4; }
.text-balance { text-wrap: balance; }
.text-pretty  { text-wrap: pretty; }

.font-display {
  font-variation-settings: 'wght' 750;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

/* Número tabulado (tablas y KPIs) */
.tabular { font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }

/* Texto con gradiente dorado */
.text-gradient-gold {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   FOCUS RING ACCESIBLE
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.focus-ring:focus-visible {
  outline: 2px solid #f59e0b;
  outline-offset: 3px;
  border-radius: 0.375rem;
}
.focus-ring-inset:focus-visible {
  outline: 2px solid #f59e0b;
  outline-offset: -2px;
  border-radius: 0.375rem;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   GLASSMORPHISM — PANELES FLOTANTES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.glass {
  background-color: var(--color-surface);
  backdrop-filter: blur(16px) saturate(1.4);
  -webkit-backdrop-filter: blur(16px) saturate(1.4);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-lg);
}

.glass-subtle {
  background-color: var(--color-nav-bg);
  backdrop-filter: blur(12px) saturate(1.2);
  -webkit-backdrop-filter: blur(12px) saturate(1.2);
  border: 1px solid var(--color-border);
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   BADGES DE ESTADO — COLORES SEMÁNTICOS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.badge-green  { color: #16a34a; background: rgba(22,163,74,0.10);  border-color: rgba(22,163,74,0.25);  }
.badge-red    { color: #dc2626; background: rgba(220,38,38,0.10);  border-color: rgba(220,38,38,0.25);  }
.badge-amber  { color: #d97706; background: rgba(217,119,6,0.10);  border-color: rgba(217,119,6,0.28);  }
.badge-blue   { color: #2563eb; background: rgba(37,99,235,0.10);  border-color: rgba(37,99,235,0.25);  }
.badge-slate  { color: var(--color-text-muted); background: var(--color-inner-card); border-color: var(--color-border); }
.badge-purple { color: #7c3aed; background: rgba(124,58,237,0.10); border-color: rgba(124,58,237,0.25); }

/* Versión sólida (pill relleno) */
.badge-solid-green  { color: #fff; background: #16a34a; border-color: #15803d; }
.badge-solid-red    { color: #fff; background: #dc2626; border-color: #b91c1c; }
.badge-solid-amber  { color: #111; background: #f59e0b; border-color: #d97706; }
.badge-solid-blue   { color: #fff; background: #2563eb; border-color: #1d4ed8; }

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   UTILIDADES DE TRANSICIÓN
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.transition-base {
  transition:
    color            0.2s cubic-bezier(0.4,0,0.2,1),
    background-color 0.2s cubic-bezier(0.4,0,0.2,1),
    border-color     0.2s cubic-bezier(0.4,0,0.2,1),
    box-shadow       0.2s cubic-bezier(0.4,0,0.2,1),
    opacity          0.2s cubic-bezier(0.4,0,0.2,1);
}

.transition-transform {
  transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
}

.transition-slow {
  transition:
    color            0.35s ease,
    background-color 0.35s ease,
    border-color     0.35s ease;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   EMPTY STATES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 4rem 2rem;
  color: var(--color-text-muted);
}
.empty-state-icon {
  width: 52px;
  height: 52px;
  margin-bottom: 1.25rem;
  color: var(--color-text-faint);
  opacity: 0.7;
}
.empty-state h3 {
  color: var(--color-text);
  font-weight: 700;
  font-size: 1.05rem;
  margin-bottom: 0.4rem;
}
.empty-state p {
  font-size: 0.875rem;
  max-width: 34ch;
  margin-bottom: 1.5rem;
  color: var(--color-text-muted);
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   SKELETON VARIANTES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.skeleton-text    { height: 1em;   margin-bottom: 0.4rem; border-radius: 0.3rem; }
.skeleton-text:last-child { width: 62%; }
.skeleton-heading { height: 1.4em; width: 42%; margin-bottom: 1rem; border-radius: 0.3rem; }
.skeleton-avatar  { width: 40px; height: 40px; border-radius: 9999px; }
.skeleton-image   { aspect-ratio: 16/9; width: 100%; border-radius: 0.75rem; }
.skeleton-card    { height: 180px; width: 100%; border-radius: 0.875rem; }
.skeleton-line    { height: 0.875em; width: 100%; border-radius: 0.25rem; margin-bottom: 0.35rem; }

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   OVERLAYS Y BACKDROPS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.overlay-dark  { background: rgba(0,0,0,0.55); backdrop-filter: blur(4px); }
.overlay-light { background: rgba(245,243,238,0.70); backdrop-filter: blur(8px); }

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   ACCESIBILIDAD
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border-width: 0;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   PRINT — ocultar chrome del admin al imprimir
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
@media print {
  .no-print,
  nav,
  aside,
  header { display: none !important; }

  body {
    background: #fff !important;
    color: #000 !important;
  }
}
