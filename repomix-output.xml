<file path="storage.rules">
// FIX [SEGURIDAD]: MIME estricto, límites 10MB/25MB y escritura limitada a admin/member.
rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  STORAGE RULES — Inmobiliaria Rincón Bedoya y Asociados
//
//  Modelo de autorización:
//    • admin   → lectura/escritura total
//    • member  → CRUD sobre imágenes de propiedades y documentos
//    • viewer  → solo lectura de assets públicos y su propia carpeta
//    • anon    → solo lectura de catálogo público y assets
//
//  IMPORTANTE:
//    - Storage usa request.auth.uid (no email) como identificador.
//    - El rol se obtiene leyendo el doc /users/{email} en Firestore.
//    - Validamos tipo MIME y tamaño máximo por upload.
// ══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function getUserRole() {
      return firestore.get(
        /databases/(default)/documents/users/$(authEmail())
      ).data.role;
    }

    function hasRole(roles) {
      return isSignedIn()
          && firestore.exists(/databases/(default)/documents/users/$(authEmail()))
          && getUserRole() in roles;
    }

    function isAdmin()    { return hasRole(['admin']); }
    function canOperate() { return hasRole(['admin', 'member']); }

    function isOwnerFolder(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validaciones de contenido
    function isImage() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/avif'
      ];
    }

    function isDocument() {
      return request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd.ms-excel')
          || request.resource.contentType.matches('application/vnd.ms-powerpoint')
          || request.resource.contentType.matches(
               'application/vnd.openxmlformats-officedocument.*'
             );
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ══════════════════════════════════════════════════════════════════════
    // PROPIEDADES — Imágenes de catálogo (público)
    // ══════════════════════════════════════════════════════════════════════
    match /properties/{propertyId}/{allPaths=**} {
      allow read:  if true;                                  // catálogo público
      allow write: if canOperate() && isImage() && maxSize(10);
      allow delete: if canOperate();
    }

    // ══════════════════════════════════════════════════════════════════════
    // DOCUMENTOS DE CONTRATOS
    // ══════════════════════════════════════════════════════════════════════
    match /contracts/{contractId}/{allPaths=**} {
      // Solo staff interno puede leer/escribir docs contractuales
      allow read:   if canOperate();
      allow write:  if canOperate() && isDocument() && maxSize(25);
      allow delete: if canOperate();
    }

    // ══════════════════════════════════════════════════════════════════════
    // AVATARS DE USUARIOS
    // Ruta: /avatars/{uid}/foto.jpg
    // ══════════════════════════════════════════════════════════════════════
    match /avatars/{userId}/{fileName} {
      allow read:   if true;
      allow write:  if canOperate() && isImage() && maxSize(10);
      allow delete: if canOperate();
    }

    // ══════════════════════════════════════════════════════════════════════
    // DOCUMENTOS DE CLIENTES (subida por el propio cliente en portal)
    // Ruta: /clients/{uid}/...
    // ══════════════════════════════════════════════════════════════════════
    match /clients/{userId}/{allPaths=**} {
      allow read:   if canOperate();
      allow write:  if canOperate() && isDocument() && maxSize(25);
      allow delete: if canOperate();
    }

    // ══════════════════════════════════════════════════════════════════════
    // ASSETS PÚBLICOS (logos, og-images, etc.)
    // ══════════════════════════════════════════════════════════════════════
    match /public/{allPaths=**} {
      allow read:  if true;
      allow write: if isAdmin() && maxSize(5);
    }

    // ══════════════════════════════════════════════════════════════════════
    // DOCUMENTOS GENERALES (módulo /documents)
    // Ruta: /documents/{category}/{entityId}/...
    //
    // AUDITORÍA: el module documents/services/document.service.js usa
    // STORAGE_ROOT = 'documents' pero antes no había regla explícita para
    // ese path → caía en default deny y la subida fallaba en producción.
    // ══════════════════════════════════════════════════════════════════════
    match /documents/{allPaths=**} {
      // Lectura: staff siempre; cliente firmado (viewer) puede leer si
      // la URL de descarga es legítima — Firebase ya gestiona el token.
      allow read:   if isSignedIn();
      allow write:  if canOperate() && isDocument() && maxSize(25);
      allow delete: if canOperate();
    }

    // ══════════════════════════════════════════════════════════════════════
    // CHAT — adjuntos en conversaciones
    // ══════════════════════════════════════════════════════════════════════
    match /chat/{conversationId}/{allPaths=**} {
      // Solo miembros del staff pueden ver/subir adjuntos
      allow read:  if canOperate();
      allow write: if canOperate() && maxSize(25);
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // DEFAULT DENY — todo lo no declarado arriba queda bloqueado
    // ══════════════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
</file>

<file path=".github/workflows/deploy.yml">
# ─────────────────────────────────────────────────────────────
# CI/CD — Inmobiliaria RyB y Asociados
#
# FLUJO:
#   push a main → lint → build → deploy a Firebase Hosting
#   PRs        → lint + build (sin deploy)
#
# SECRETS requeridos en GitHub → Settings → Secrets → Actions:
#
#   FIREBASE_SERVICE_ACCOUNT   → JSON de cuenta de servicio Firebase
#
#   # Firebase core
#   VITE_FIREBASE_API_KEY
#   VITE_FIREBASE_AUTH_DOMAIN
#   VITE_FIREBASE_DATABASE_URL
#   VITE_FIREBASE_PROJECT_ID
#   VITE_FIREBASE_STORAGE_BUCKET
#   VITE_FIREBASE_MESSAGING_SENDER_ID
#   VITE_FIREBASE_APP_ID
#   VITE_FIREBASE_MEASUREMENT_ID
#
#   # App Check (reCAPTCHA v3)
#   VITE_FIREBASE_APP_CHECK_KEY
#
#   # Cloud Messaging (Web Push certificate)
#   VITE_VAPID_KEY          # ← corregido: antes VITE_FIREBASE_VAPID_KEY (no coincidía con el código cliente)
#
#   # Google Maps
#   VITE_GOOGLE_MAPS_API_KEY
#
#   # WhatsApp Business
#   VITE_WA_NUMBER
#
#   # Opcional: sobrescribir URL base de Cloud Functions
#   # VITE_FUNCTIONS_BASE_URL
# ─────────────────────────────────────────────────────────────

name: CI and Deploy Firebase

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  ci-deploy:
    name: Lint Test Build Deploy
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install client deps
        run: npm ci

      - name: Install functions deps
        working-directory: functions
        run: npm ci

      - name: Lint
        run: npm run lint

      - name: Test
        run: npm test

      - name: Build
        env:
          VITE_FIREBASE_API_KEY:             ${{ secrets.VITE_FIREBASE_API_KEY }}
          VITE_FIREBASE_AUTH_DOMAIN:         ${{ secrets.VITE_FIREBASE_AUTH_DOMAIN }}
          VITE_FIREBASE_DATABASE_URL:        ${{ secrets.VITE_FIREBASE_DATABASE_URL }}
          VITE_FIREBASE_PROJECT_ID:          ${{ secrets.VITE_FIREBASE_PROJECT_ID }}
          VITE_FIREBASE_STORAGE_BUCKET:      ${{ secrets.VITE_FIREBASE_STORAGE_BUCKET }}
          VITE_FIREBASE_MESSAGING_SENDER_ID: ${{ secrets.VITE_FIREBASE_MESSAGING_SENDER_ID }}
          VITE_FIREBASE_APP_ID:              ${{ secrets.VITE_FIREBASE_APP_ID }}
          VITE_FIREBASE_MEASUREMENT_ID:      ${{ secrets.VITE_FIREBASE_MEASUREMENT_ID }}
          VITE_FIREBASE_APP_CHECK_KEY:       ${{ secrets.VITE_FIREBASE_APP_CHECK_KEY }}
          # ★ FIX: el cliente usa VITE_VAPID_KEY (no VITE_FIREBASE_VAPID_KEY).
          VITE_VAPID_KEY:                    ${{ secrets.VITE_VAPID_KEY }}
          # ★ FIX: faltaban estas variables → Maps, WhatsApp y Functions URL
          #         quedaban undefined en producción.
          VITE_GOOGLE_MAPS_API_KEY:          ${{ secrets.VITE_GOOGLE_MAPS_API_KEY }}
          VITE_WA_NUMBER:                    ${{ secrets.VITE_WA_NUMBER }}
          VITE_FUNCTIONS_BASE_URL:           ${{ secrets.VITE_FUNCTIONS_BASE_URL }}
        run: npm run build
      - name: Install Firebase CLI
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: npm install -g firebase-tools

      - name: Authenticate to Google Cloud
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}

      - name: Deploy Firestore rules
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: firebase deploy --only firestore:rules --project inmobiliaria-ryb-y-asociados --non-interactive

      - name: Deploy Storage rules
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: firebase deploy --only storage:rules --project inmobiliaria-ryb-y-asociados --non-interactive

      - name: Deploy Functions
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: firebase deploy --only functions --project inmobiliaria-ryb-y-asociados --non-interactive

      - name: Deploy Hosting
        if: github.event_name == 'push' && github.ref == 'refs/heads/main'
        run: firebase deploy --only hosting:production --project inmobiliaria-ryb-y-asociados --non-interactive
</file>

<file path="eslint.config.js">
// ═══════════════════════════════════════════════════════════════════════════
//  ESLint Flat Config — ESLint 9.x
//
//  Filosofía:
//    - Errores de sintaxis / bugs reales → `error`
//    - Antipatrones estilísticos (incluso los nuevos y estrictos de
//      react-hooks v7) → `warning`, para no bloquear iteración.
//
//  Reglas de react-hooks v7 usadas: solo las que existen realmente en
//  esta versión del plugin (verificadas contra node_modules).
// ═══════════════════════════════════════════════════════════════════════════

import js           from '@eslint/js';
import globals      from 'globals';
import reactHooks   from 'eslint-plugin-react-hooks';
import reactRefresh from 'eslint-plugin-react-refresh';
import jsxA11y      from 'eslint-plugin-jsx-a11y';

export default [
  // ── Ignores globales ───────────────────────────────────────────────────
  {
    ignores: [
      'dist/**',
      'build/**',
      'coverage/**',
      'public/**',
      '**/*.min.js',
      'node_modules/**',
      'functions/node_modules/**',
      '.firebase/**',
    ],
  },

  // ── Recomendaciones base JS ────────────────────────────────────────────
  js.configs.recommended,

  // ── Cliente React ───────────────────────────────────────────────────────
  {
    files: ['src/**/*.{js,jsx}'],
    plugins: {
      'react-hooks':   reactHooks,
      'react-refresh': reactRefresh,
      'jsx-a11y':      jsxA11y,
    },
    languageOptions: {
      ecmaVersion: 'latest',
      sourceType:  'module',
      globals:     { ...globals.browser, ...globals.serviceworker },
      parserOptions: {
        ecmaFeatures: { jsx: true },
      },
    },
    rules: {
      // ── React Hooks — críticas (error) ───────────────────────────────────
      'react-hooks/rules-of-hooks':  'error',
      'react-hooks/exhaustive-deps': 'warn',

      // ── React Hooks v7 — reglas estrictas nuevas (warning) ──────────────
      // Flagean patrones normales que no son bugs reales en la mayoría
