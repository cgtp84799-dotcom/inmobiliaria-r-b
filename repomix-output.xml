.chip-venta { background: var(--cf-gold); color: var(--cf-navy); }
.chip-arriendo { background: #2563eb; color: #fff; }
.chip-both { background: #059669; color: #fff; }
.chip-disponible { background: #16a34a; color: #fff; }
.chip-reservada { background: #f59e0b; color: #fff; }
.chip-vendida { background: #dc2626; color: #fff; }
.chip-arrendada { background: #2563eb; color: #fff; }

.chip-type {
