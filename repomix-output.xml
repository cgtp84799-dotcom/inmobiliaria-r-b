        </div>
      )}

      {/* ── FAQs expandibles ──────────────────────────────── */}
      {faqs.length > 0 && (
        <div className="max-w-3xl mb-10">
          <h3 className="text-xl font-semibold mb-4">Preguntas frecuentes</h3>
          <ul className="space-y-2">
            {faqs.map((f, i) => (
              <li
                key={`faq-${i}`}
                className="rounded-lg border overflow-hidden"
                style={{ borderColor: "var(--color-border, #334155)" }}
