  padding: 12px 18px;
  font-family: var(--cf-font);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: transform .2s ease, opacity .2s ease, background .2s ease;
}

.cflyer-btn-dl {
