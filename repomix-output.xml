        </div>

        {/* Separador */}
        <div className="flex items-center gap-3 my-4">
          <div className="flex-1 h-px bg-slate-700"></div>
          <span className="text-slate-500 text-sm font-medium">O</span>
          <div className="flex-1 h-px bg-slate-700"></div>
