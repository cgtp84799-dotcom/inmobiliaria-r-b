  /* ── Footer ── */
  --color-footer-bg:      #030610;
  --color-footer-border:  rgba(255,255,255,0.055);
  --color-footer-text:    #d4d0c8;
  --color-footer-muted:   #5b5855;

  /* ── Navbar ── */
  --color-nav-bg:         rgba(3,8,18,0.88);
  --color-nav-border:     rgba(165,180,210,0.08);
  --color-nav-text:       #e8eaed;
  --color-nav-text-sub:   #9ba5b6;

  /* ── Topbar ── */
  --color-topbar-bg:      rgba(7,11,24,0.93);
  --color-topbar-border:  rgba(165,180,210,0.08);

  /* ── Inputs ── */
  --color-input-bg:       #101828;
  --color-input-border:   rgba(165,180,210,0.13);
  --color-input-text:     #e8eaed;
  --color-input-focus:    #fbbf24;

  /* ── Modales ── */
  --color-modal-bg:       #0a1020;
  --color-modal-border:   rgba(165,180,210,0.10);

  /* ── Filas/tablas ── */
  --color-row-hover:      rgba(255,255,255,0.035);
  --color-row-stripe:     rgba(255,255,255,0.018);
  --color-inner-card:     rgba(255,255,255,0.03);
