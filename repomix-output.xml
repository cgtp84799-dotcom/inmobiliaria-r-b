import { db } from "../../../core/config/firebase.config";
import PropertyMap from "../../properties/components/PropertyMap";
import PropertyPrintView from "./PropertyPrintView";
import PropertyClientPrint  from "./PropertyClientPrint";
import {
  FaTimes,
  FaEdit,
  FaTrash,
  FaMapMarkerAlt,
  FaBed,
  FaBath,
  FaCar,
  FaRulerCombined,
  FaCalendar,
