  --color-text-muted:     #5a534a;
  --color-text-faint:     #9a938a;
  --color-text-inverse:   #faf7f2;

  /* ── Accent gold tokens (semánticos — úsalos en vez de hexadecimales) ── */
  --color-gold:           #b45309;
  --color-gold-hover:     #92400e;
  --color-gold-soft:      #d97706;

  /* ── Sidebar — siempre oscuro, azul noche elegante ── */
